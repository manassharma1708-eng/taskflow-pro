# TaskFlow Pro - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# DATABASE
# ============================================
# Default: SQLite (zero-configuration, great for local dev & evaluation)
# For PostgreSQL, uncomment and set the DATABASE_URL below
# DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow_db
DATABASE_URL=sqlite:///./taskflow.db

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000

# ============================================
# GOOGLE GEMINI AI (Optional)
# ============================================
# Get your API key from https://aistudio.google.com/apikey
# The app works fully without this — AI features gracefully degrade
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# API SERVER
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
